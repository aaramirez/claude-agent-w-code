Screen {
    background: $surface;
    overflow-x: hidden;
}

#conversation {
    height: 1fr;
    border: solid $accent;
    padding: 0 1;
    background: $surface;
    overflow-x: hidden;
}

#conversation:focus {
    border: solid $success;
}

#status-bar {
    dock: bottom;
    height: 1;
    background: $accent-darken-1;
    color: $text;
    padding: 0 1;
    max-width: 100%;
}

#input {
    dock: bottom;
    margin: 0 0 1 0;
    border: tall $accent;
    max-width: 100%;
}

#input:focus {
    border: tall $success;
}

#debug-indicator {
    color: $warning;
    text-style: bold;
}
